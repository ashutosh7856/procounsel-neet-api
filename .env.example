# Shared ProCounsellor Firestore (production project procounsellor-71824).
# Service-account file — ask a maintainer; never commit it.
FIREBASE_CREDENTIALS_PATH=.secrets/firebase-prod.json
# On Vercel use the JSON itself instead:
# FIREBASE_CONFIG={"type":"service_account",...}

# Base64 HS256 key the main backend signs login JWTs with (app users and Admin panel) — ask a maintainer.
PROCOUNSEL_JWT_SECRET=

# Optional: Realtime Database URL
# FIREBASE_REALTIME_CONFIG=https://<project>-default-rtdb.firebaseio.com

# AI tutor (MBA)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MBA_AI_DAILY_LIMIT=30

# MBA content review (/api/v1/mba/admin): admin roles allowed, comma-separated; * = any admin
MBA_CONTENT_ADMIN_ROLES=superAdmin,COURSE

# MBA application documents: the existing Firebase Storage bucket (same var as the Java backend; MBA_DOCS_BUCKET overrides).
# Signing uses the Firestore service account above (needs storage.objects.create/get/delete). Unset = uploads disabled (503).
BUCKET_NAME=procounsellor-71824.firebasestorage.app
# Voice practice in the AI mock PI (speech-to-text model; audio is never stored)
# MBA_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
